#!/bin/sh
# Downloads the pinned Claude Code build for this architecture from Anthropic into DIR, verifies it
# against checksums.txt and removes other versions it downloaded before.

set -eu

root="${WODBY_AGENTS_ROOT:-/opt/wodby/agents}"
. "${root}/versions.env"
dir="$1"

case "$(uname -m)" in
x86_64) platform=linux-x64-musl ;;
aarch64) platform=linux-arm64-musl ;;
*) echo "claude: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

file="claude-${CLAUDE_CODE_VERSION}-${platform}"
checksum="$(awk -v file="${file}" '$2 == file { print $1 }' "${root}/checksums.txt")"
if [ -z "${checksum}" ]; then
    echo "claude: no checksum for ${file}" >&2
    exit 1
fi

url="https://downloads.claude.ai/claude-code-releases/${CLAUDE_CODE_VERSION}/${platform}/claude"
parent="$(dirname "${dir}")"
mkdir -p "${dir}"
part="$(mktemp "${parent}/.claude.XXXXXX")"
trap 'rm -f "${part}"' EXIT

echo "Downloading Claude Code ${CLAUDE_CODE_VERSION} from Anthropic. This happens once per version." >&2
if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 -o "${part}" "${url}"
elif command -v wget >/dev/null 2>&1; then
    wget -q -O "${part}" "${url}"
else
    echo "claude: curl or wget is needed to download Claude Code" >&2
    exit 1
fi

if ! echo "${checksum}  ${part}" | sha256sum -c - >/dev/null 2>&1; then
    echo "claude: the download from ${url} failed checksum verification" >&2
    exit 1
fi
chmod 0755 "${part}"
# A rename, so a concurrent first run never executes a partial file.
mv -f "${part}" "${dir}/claude"

for other in "${parent}"/*; do
    if [ "${other}" != "${dir}" ]; then
        rm -rf "${other}"
    fi
done
